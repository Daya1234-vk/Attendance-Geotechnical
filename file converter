<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Geotechnical Engineering Lab Attendance - Cloud Sync</title>
  
  <!-- Firebase Compatibility SDKs for Realtime Database -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

  <style>
    :root {
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --border: #cbd5e1;
      --present: #16a34a;
      --absent: #dc2626;
      --unmarked: #64748b;
    }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      padding: 1.5rem 1rem;
      margin: 0;
    }
    .container {
      max-width: 98%;
      margin: 0 auto;
    }
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 1rem;
      background: var(--card);
      padding: 1rem 1.25rem;
      border-radius: 8px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }
    .sync-status {
      font-size: 0.85rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .sync-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #94a3b8;
    }
    .sync-online { background: #16a34a; }
    .sync-error { background: #dc2626; }

    .section-card {
      background: var(--card);
      padding: 1.25rem;
      border-radius: 8px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
      margin-bottom: 2rem;
    }
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #e2e8f0;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .section-title {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 700;
      color: #1e293b;
    }
    .table-wrapper {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 6px;
    }
    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      text-align: left;
      font-size: 0.85rem;
      white-space: nowrap;
    }
    th, td {
      padding: 0.45rem 0.5rem;
      border-bottom: 1px solid var(--border);
      border-right: 1px solid #e2e8f0;
      background: var(--card);
    }
    th {
      background: #f1f5f9;
      font-weight: 600;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .sticky-name {
      position: sticky;
      left: 0;
      z-index: 20;
      min-width: 170px;
      background: var(--card);
      box-shadow: 2px 0 5px rgba(0,0,0,0.08);
    }
    th.sticky-name {
      background: #f1f5f9;
      z-index: 30;
    }
    .date-header { text-align: center; padding: 4px; }
    .date-input {
      font-family: inherit;
      font-size: 0.75rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 2px 4px;
      background: #ffffff;
      color: var(--text);
      cursor: pointer;
    }
    .status-select {
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.25rem 0.15rem;
      border-radius: 4px;
      border: 1px solid var(--border);
      cursor: pointer;
      text-align: center;
      outline: none;
      width: 48px;
    }
    .status-select.sel-empty { background: #f1f5f9; color: var(--unmarked); border-color: #cbd5e1; }
    .status-select.sel-P { background: #dcfce7; color: var(--present); border-color: #86efac; }
    .status-select.sel-A { background: #fee2e2; color: var(--absent); border-color: #fca5a5; }

    .btn {
      color: white;
      border: none;
      padding: 0.45rem 0.85rem;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .btn-add { background: #0284c7; }
    .btn-add:hover { background: #0369a1; }
    .btn-reset { background: #ef4444; }
    .btn-reset:hover { background: #dc2626; }
  </style>
</head>
<body>
  <div class="container">
    <div class="top-bar">
      <div>
        <h2 style="margin: 0; font-size: 1.35rem;">Geotechnical Engineering Lab Attendance</h2>
        <div class="sync-status">
          <div id="sync-dot" class="sync-dot"></div>
          <span id="sync-text">Connecting to Firebase...</span>
        </div>
      </div>
      <div style="display: flex; gap: 0.75rem;">
        <button class="btn btn-reset" onclick="resetAll()">Clear Cloud Data</button>
      </div>
    </div>

    <!-- Batch 1 (1–30) -->
    <div class="section-card">
      <div class="section-header">
        <h3 class="section-title">Batch 1 (Students 1 – 30)</h3>
        <button class="btn btn-add" onclick="addBatchColumn(0)">+ Add Date Column (Batch 1)</button>
      </div>
      <div class="table-wrapper">
        <table>
          <thead><tr id="header-batch-0"></tr></thead>
          <tbody id="body-batch-0"></tbody>
        </table>
      </div>
    </div>

    <!-- Batch 2 (31–61) -->
    <div class="section-card">
      <div class="section-header">
        <h3 class="section-title">Batch 2 (Students 31 – 61)</h3>
        <button class="btn btn-add" onclick="addBatchColumn(1)">+ Add Date Column (Batch 2)</button>
      </div>
      <div class="table-wrapper">
        <table>
          <thead><tr id="header-batch-1"></tr></thead>
          <tbody id="body-batch-1"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    const firebaseConfig = {
      apiKey: "AIzaSyCd29X3MoHJEnz37dPLCHViSdiee3DAZHc",
      authDomain: "attendance-app-61b68.firebaseapp.com",
      databaseURL: "https://attendance-app-61b68-default-rtdb.firebaseio.com",
      projectId: "attendance-app-61b68",
      storageBucket: "attendance-app-61b68.firebasestorage.app",
      messagingSenderId: "969455602479",
      appId: "1:969455602479:web:21e7180ab7a9699f9c212a"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();
    // Unique Firebase path so it does not overwrite the other lab's data
    const batchDataRef = db.ref('geotech_lab_batches');

    // Batch 1: 30 Students (1 to 30)
    const batch1Students = [
      { sl: 1, usn: "2GO24CV001", name: "ABHINAYA" },
      { sl: 2, usn: "2GO24CV003", name: "AISHWARYA K N" },
      { sl: 3, usn: "2GO24CV004", name: "ALFIYABANU K" },
      { sl: 4, usn: "2GO24CV005", name: "ARUNA" },
      { sl: 5, usn: "2GO24CV009", name: "CHETHANA K H" },
      { sl: 6, usn: "2GO24CV010", name: "DAYANAND" },
      { sl: 7, usn: "2GO24CV011", name: "HARSHA" },
      { sl: 8, usn: "2GO24CV012", name: "IMAMHUSEN R G" },
      { sl: 9, usn: "2GO24CV013", name: "KAVITHA" },
      { sl: 10, usn: "2GO24CV014", name: "KAVYA B" },
      { sl: 11, usn: "2GO24CV015", name: "KAVYA I" },
      { sl: 12, usn: "2GO24CV016", name: "KIRAN M M" },
      { sl: 13, usn: "2GO24CV017", name: "LAXMAVVA" },
      { sl: 14, usn: "2GO24CV018", name: "LAXMEE Y H" },
      { sl: 15, usn: "2GO24CV019", name: "MADHUMATHI" },
      { sl: 16, usn: "2GO24CV020", name: "MADHUSUDAN" },
      { sl: 17, usn: "2GO24CV021", name: "NAVEEN T Y" },
      { sl: 18, usn: "2GO24CV022", name: "NIKITA" },
      { sl: 19, usn: "2GO24CV023", name: "NIVEDITA" },
      { sl: 20, usn: "2GO24CV024", name: "NIKIL P" },
      { sl: 21, usn: "2GO24CV025", name: "PRAVEENKUMAR B" },
      { sl: 22, usn: "2GO24CV026", name: "PRIYANKA Y H" },
      { sl: 23, usn: "2GO24CV027", name: "ROOPA D" },
      { sl: 24, usn: "2GO24CV030", name: "SANGEETA K" },
      { sl: 25, usn: "2GO24CV031", name: "SANIYA K" },
      { sl: 26, usn: "2GO24CV032", name: "SHALINI S P" },
      { sl: 27, usn: "2GO24CV033", name: "SHALINI U T" },
      { sl: 28, usn: "2GO24CV036", name: "SHRUTI G" },
      { sl: 29, usn: "2GO24CV037", name: "SIDDANAGOUDA" },
      { sl: 30, usn: "2GO24CV038", name: "SINDHU" }
    ];

    // Batch 2: 31 Students (31 to 61)
    const batch2Students = [
      { sl: 31, usn: "2GO24CV039", name: "SNEHA" },
      { sl: 32, usn: "2GO24CV040", name: "SRUSTI I" },
      { sl: 33, usn: "2GO24CV041", name: "SUDHA S H" },
      { sl: 34, usn: "2GO24CV042", name: "SWATHI" },
      { sl: 35, usn: "2GO24CV043", name: "YASHWANTH P K" },
      { sl: 36, usn: "2GO25CV400", name: "AKASH K N" },
      { sl: 37, usn: "2GO25CV401", name: "AMRUTHA N" },
      { sl: 38, usn: "2GO25CV402", name: "BHARAT S" },
      { sl: 39, usn: "2GO25CV404", name: "CHANDRAKANTH D C" },
      { sl: 40, usn: "2GO25CV405", name: "DHANUSHREE" },
      { sl: 41, usn: "2GO25CV406", name: "KAVYA M A" },
      { sl: 42, usn: "2GO25CV407", name: "KAVYA S K" },
      { sl: 43, usn: "2GO25CV408", name: "KEERTHI B T" },
      { sl: 44, usn: "2GO25CV409", name: "KUMAR K" },
      { sl: 45, usn: "2GO25CV410", name: "NIGARAJ B M" },
      { sl: 46, usn: "2GO25CV411", name: "NUTANSAGAR" },
      { sl: 47, usn: "2GO25CV412", name: "PRAVEENKUMAR U D" },
      { sl: 48, usn: "2GO25CV413", name: "PRIYANKA P" },
      { sl: 49, usn: "2GO25CV414", name: "PRUTHVI P G" },
      { sl: 50, usn: "2GO25CV416", name: "RAKSHITHA" },
      { sl: 51, usn: "2GO25CV417", name: "RAMESH S H" },
      { sl: 52, usn: "2GO25CV418", name: "SAMPATTA" },
      { sl: 53, usn: "2GO25CV419", name: "SANNAOBANAYAKA" },
      { sl: 54, usn: "2GO25CV420", name: "SIDDESH N S" },
      { sl: 55, usn: "2GO25CV421", name: "SNEHA D" },
      { sl: 56, usn: "2GO25CV422", name: "SRUJAN K S" },
      { sl: 57, usn: "2GO25CV423", name: "SUHAS R M" },
      { sl: 58, usn: "2GO25CV424", name: "UDITH KUMAR G M" },
      { sl: 59, usn: "2GO25CV425", name: "VARSHA" },
      { sl: 60, usn: "2GO25CV426", name: "VIKAS L P" },
      { sl: 61, usn: "2GO25CV427", name: "YASHODA" }
    ];

    function createDefaultBatch(studentList) {
      return {
        dates: ["", "", "", "", "", ""],
        records: studentList.map(s => ({ ...s, days: Array(6).fill("") }))
      };
    }

    let batchData = [
      createDefaultBatch(batch1Students),
      createDefaultBatch(batch2Students)
    ];

    function updateIndicator(state, text) {
      const dot = document.getElementById('sync-dot');
      const label = document.getElementById('sync-text');
      dot.className = `sync-dot sync-${state}`;
      label.textContent = text;
    }

    batchDataRef.on('value', (snapshot) => {
      const data = snapshot.val();
      if (data) {
        batchData = data;
      } else {
        batchDataRef.set(batchData);
      }
      render();
      updateIndicator('online', 'Connected & Synced (Live)');
    }, (error) => {
      console.error(error);
      updateIndicator('error', 'Database Permission Denied');
    });

    function render() {
      batchData.forEach((bObj, bIdx) => {
        const headerRow = document.getElementById(`header-batch-${bIdx}`);
        headerRow.innerHTML = `
          <th>Sl.</th>
          <th class="sticky-name">Name</th>
          <th>USN</th>
        `;

        (bObj.dates || []).forEach((dVal, cIdx) => {
          headerRow.innerHTML += `
            <th class="date-header">
              <input type="date" class="date-input" value="${dVal || ''}" onchange="updateBatchDate(${bIdx}, ${cIdx}, this.value)" />
            </th>
          `;
        });

        headerRow.innerHTML += `<th style="text-align:center;">Att. %</th>`;

        const tbody = document.getElementById(`body-batch-${bIdx}`);
        tbody.innerHTML = '';

        (bObj.records || []).forEach((s, sIdx) => {
          const tr = document.createElement('tr');
          const days = s.days || [];
          
          let present = days.filter(d => d === 'P').length;
          let marked = days.filter(d => d === 'P' || d === 'A').length;
          let percentageDisplay = marked === 0 ? '-' : Math.round((present / marked) * 100) + '%';

          let dayDropdowns = days.map((val, dIdx) => `
            <td style="text-align:center; padding: 2px;">
              <select class="status-select sel-${val || 'empty'}" onchange="updateBatchStatus(${bIdx}, ${sIdx}, ${dIdx}, this.value)">
                <option value="" ${val === '' ? 'selected' : ''}>-</option>
                <option value="P" ${val === 'P' ? 'selected' : ''}>P</option>
                <option value="A" ${val === 'A' ? 'selected' : ''}>A</option>
              </select>
            </td>
          `).join('');

          tr.innerHTML = `
            <td style="text-align:center;">${s.sl}</td>
            <td class="sticky-name"><strong>${s.name}</strong></td>
            <td><code>${s.usn}</code></td>
            ${dayDropdowns}
            <td style="text-align:center; font-weight:700;">${percentageDisplay}</td>
          `;
          tbody.appendChild(tr);
        });
      });
    }

    function updateBatchDate(bIdx, cIdx, val) {
      batchDataRef.child(`${bIdx}/dates/${cIdx}`).set(val);
    }

    function updateBatchStatus(bIdx, sIdx, dIdx, val) {
      batchDataRef.child(`${bIdx}/records/${sIdx}/days/${dIdx}`).set(val);
    }

    function addBatchColumn(bIdx) {
      const newDates = batchData[bIdx].dates ? [...batchData[bIdx].dates, ""] : [""];
      const newRecords = batchData[bIdx].records.map(r => ({
        ...r,
        days: r.days ? [...r.days, ""] : [""]
      }));
      batchDataRef.child(`${bIdx}`).set({ dates: newDates, records: newRecords });
    }

    function resetAll() {
      if (confirm("Are you sure you want to clear all cloud attendance data for Geotechnical Lab?")) {
        batchData = [
          createDefaultBatch(batch1Students),
          createDefaultBatch(batch2Students)
        ];
        batchDataRef.set(batchData);
      }
    }
  </script>
</body>
</html>
